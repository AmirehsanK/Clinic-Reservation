<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- The machine-wide NuGet.Config on this box has an empty <packageSources>,
         so restore finds no feed at all. Declaring nuget.org here keeps the fix
         with the solution instead of changing global machine configuration. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
