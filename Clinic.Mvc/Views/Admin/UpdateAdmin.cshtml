@model UpdateUserDto
@{
    ViewData["Title"] = "Edit Admin";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Edit Admin Details</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="UpdateAdmin" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Mobile" class="form-label">Mobile Number</label>
                        <input asp-for="Mobile" class="form-control" placeholder="e.g. 5551234567" />
                        <span asp-validation-for="Mobile" class="text-danger small mt-1"></span>
                    </div>

                    <div class="form-footer d-flex justify-content-between">
                        <a asp-controller="Admin" asp-action="AdminsList" class="btn btn-link">
                            <i class="ti ti-arrow-left me-1"></i>
                            Back to list
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
