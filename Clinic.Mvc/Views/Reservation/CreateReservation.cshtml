@model CreateReservationDto
@{
    ViewData["Title"] = "New Time Slot";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Time Slot Details</h3>
            </div>
            <div class="card-body">
                <form asp-controller="Reservation" asp-action="CreateReservation" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label for="ReserveTime" class="form-label">Start Time</label>
                        <input type="datetime-local" id="ReserveTime" name="ReserveTime" class="form-control"
                               value="@Model.ReserveTime.ToHtmlDateTimeLocal()" />
                        <span asp-validation-for="ReserveTime" class="text-danger small mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label for="EndReserveTime" class="form-label">End Time</label>
                        <input type="datetime-local" id="EndReserveTime" name="EndReserveTime" class="form-control"
                               value="@Model.EndReserveTime.ToHtmlDateTimeLocal()" />
                        <span asp-validation-for="EndReserveTime" class="text-danger small mt-1"></span>
                    </div>

                    <div class="form-footer d-flex justify-content-between">
                        <a asp-controller="Reservation" asp-action="FilterReservation" class="btn btn-link">
                            <i class="ti ti-arrow-left me-1"></i>
                            Back to list
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Save Time Slot
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
