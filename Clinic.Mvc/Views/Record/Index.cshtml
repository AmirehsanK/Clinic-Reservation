@model FilterRecordsDto
@{
    ViewData["Title"] = "Records";
}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Filter Records</h3>
    </div>
    <div class="card-body">
        <form id="filterForm" asp-controller="Record" asp-action="Index" method="get">
            <input type="hidden" asp-for="PageId" id="PageId" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="PatientName" class="form-label">Patient Name</label>
                    <input asp-for="PatientName" class="form-control" placeholder="Search by patient name" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PatientNationalId" class="form-label">Patient National ID</label>
                    <input asp-for="PatientNationalId" class="form-control" placeholder="Search by national ID" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FilterRecordStatus>()"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PaymentType" class="form-label">Payment Type</label>
                    <select asp-for="PaymentType" class="form-select" asp-items="Html.GetEnumSelectList<FilterPaymentType>()"></select>
                </div>
            </div>
            <div class="form-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-filter me-1"></i>
                    Apply Filters
                </button>
                <a asp-controller="Record" asp-action="Index" class="btn btn-link">
                    <i class="ti ti-x me-1"></i>
                    Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Appointment Records</h3>
        <div class="card-actions">
            <span class="badge bg-blue-lt">@Model.AllEntitiesCount total</span>
        </div>
    </div>

    @if (Model.Data is null || Model.Data.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><i class="ti ti-clipboard-list" style="font-size: 3rem;"></i></div>
            <p class="empty-title">No records found</p>
            <p class="empty-subtitle text-secondary">Try adjusting your filters.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Patient</th>
                    <th>Appointment Time</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Paid Price</th>
                    <th class="w-1">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var record in Model.Data)
                {
                    <tr>
                        <td class="text-secondary">@record.Id</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm bg-pink-lt me-2"><i class="ti ti-user"></i></span>
                                <div>
                                    <div>@record.Patient?.FullName</div>
                                    <div class="text-secondary small">@record.Patient?.Mobile</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary">
                            @(record.Reservation != null ? record.Reservation.ReserveTime.ToString("MMM dd, yyyy HH:mm") : "-")
                        </td>
                        <td><span class="badge @record.Status.ToBadgeClass()">@record.Status.GetDisplayName()</span></td>
                        <td><span class="badge @record.PaymentType.ToBadgeClass()">@record.PaymentType.GetDisplayName()</span></td>
                        <td class="text-secondary">@(record.PaidPrice?.ToString("#,0") ?? "-")</td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a asp-controller="Record" asp-action="EditRecord" asp-route-id="@record.Id"
                                   class="btn btn-outline-primary btn-icon" title="Edit" aria-label="Edit record @record.Id">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <a asp-controller="Record" asp-action="DeleteRecord" asp-route-id="@record.Id"
                                   class="btn btn-outline-danger btn-icon" title="Delete" aria-label="Delete record @record.Id"
                                   data-confirm="Are you sure you want to delete this record?">
                                    <i class="ti ti-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-secondary">@Model.GetCurrentPagingStatus()</p>
            <div class="ms-auto">
                @await Html.PartialAsync("_Pagination", (BasePaging)Model)
            </div>
        </div>
    }
</div>
