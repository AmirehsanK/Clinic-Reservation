@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? controllerName;

    var navLinks = new (string Controller, string Action, string Icon, string Title)[]
    {
        ("Home", "Dashboard", "ti-dashboard", "Dashboard"),
        ("Admin", "AdminsList", "ti-user-shield", "Admins"),
        ("Patient", "FilterPatients", "ti-users", "Patients"),
        ("Reservation", "FilterReservation", "ti-calendar-time", "Reservations"),
        ("Record", "Index", "ti-clipboard-list", "Records")
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle - Clinic Reservation</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="page">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <header class="navbar navbar-expand-md navbar-light d-print-none">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
                    <a asp-controller="Home" asp-action="Index" class="text-reset text-decoration-none d-flex align-items-center">
                        <i class="ti ti-stethoscope me-2 fs-2"></i>
                        <span>Clinic Reservation</span>
                    </a>
                </h1>
                <div class="navbar-nav flex-row order-md-last">
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                            <span class="avatar avatar-sm bg-primary-lt"><i class="ti ti-user"></i></span>
                            <div class="d-none d-xl-block ps-2">
                                <div>@User.Identity!.Name</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item">
                                <i class="ti ti-logout me-2"></i>
                                Sign out
                            </a>
                        </div>
                    </div>
                </div>
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
                        <ul class="navbar-nav">
                            @foreach (var link in navLinks)
                            {
                                <li class="nav-item @(controllerName == link.Controller ? "active" : "")">
                                    <a class="nav-link" asp-controller="@link.Controller" asp-action="@link.Action">
                                        <span class="nav-link-icon"><i class="ti @link.Icon"></i></span>
                                        <span class="nav-link-title">@link.Title</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </header>
    }

    <div class="page-wrapper">

        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        @if (!string.IsNullOrEmpty(controllerName) && controllerName != "Home")
                        {
                            <div class="page-pretitle">@controllerName</div>
                        }
                        <h2 class="page-title">@pageTitle</h2>
                    </div>
                    <div class="col-auto ms-auto d-print-none">
                        @await RenderSectionAsync("PageActions", required: false)
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                @await Html.PartialAsync("_Alerts")
                @RenderBody()
            </div>
        </div>

        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl">
                <div class="row text-center align-items-center flex-row-reverse">
                    <div class="col-lg-auto ms-lg-auto">
                        <ul class="list-inline list-inline-dots mb-0">
                            <li class="list-inline-item">
                                <a href="https://docs.tabler.io/" target="_blank" rel="noopener" class="link-secondary">Tabler UI</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                        Clinic Reservation &copy; @DateTime.Now.Year
                    </div>
                </div>
            </div>
        </footer>
    </div>
</div>

@* Shared confirmation modal used by [data-confirm] delete links *@
<div class="modal modal-blur fade" id="confirm-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-trash icon mb-2 text-danger icon-lg"></i>
                <h3>Are you sure?</h3>
                <div class="text-secondary" data-confirm-message>This action cannot be undone.</div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col"><a href="#" class="btn w-100" data-bs-dismiss="modal">Cancel</a></div>
                        <div class="col"><a href="#" data-confirm-accept class="btn btn-danger w-100">Delete</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/js/tabler.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
